# Maintainer: cachewraith <somonorhong011@gmail.com>
# AUR package wraithgrid-bin: the release's own Arch package, unpacked. Version and hash are
# written by scripts/update-packaging.sh; publish with `makepkg --printsrcinfo > .SRCINFO`
# and a push to ssh://aur@aur.archlinux.org/wraithgrid-bin.git.
pkgname=wraithgrid-bin
_pkgname=wraithgrid
pkgver=1.8.0
pkgrel=1
pkgdesc='Run many agent CLI sessions side by side, each with its own account and project folder'
arch=('x86_64')
url='https://github.com/cachewraith/wraithgrid'
license=('MIT')
depends=('gtk3' 'nss' 'at-spi2-core' 'libcups' 'dbus' 'mesa' 'alsa-lib' 'libxkbcommon'
  'libxcomposite' 'libxdamage' 'libxrandr' 'libxfixes' 'systemd-libs' 'expat' 'xdg-utils')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-x64.pacman")
noextract=("$_pkgname-$pkgver-x64.pacman")
sha256sums=('0492e0b514e2bd6af08346d1482fa06dd1ba8730d7ae86e7d1fcc511437a060b')

package() {
  bsdtar -xf "$srcdir/$_pkgname-$pkgver-x64.pacman" -C "$pkgdir" \
    --exclude .PKGINFO --exclude .MTREE --exclude .INSTALL --exclude .BUILDINFO
  # The release package makes this link in its install hook, which is not carried over.
  install -d "$pkgdir/usr/bin"
  ln -s /opt/Wraithgrid/wraithgrid "$pkgdir/usr/bin/wraithgrid"
}
